# Iris environment variables — copy to .env and fill in values
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Deployment mode (default: sqlite)
# ---------------------------------------------------------------------------
# Set to "supabase" to use Supabase/PostgreSQL + Supabase Auth.
# All other variables in this file are only required in supabase mode.
IRIS_DB_BACKEND=sqlite

# ---------------------------------------------------------------------------
# SQLite mode (default, self-hosted)
# ---------------------------------------------------------------------------
# Directory where iris.db and iris_audit.db are stored.
IRIS_DATA_DIR=data

# JWT secret for Iris-issued access tokens (SQLite mode).
# Must be at least 32 characters. Change this in production.
IRIS_JWT_SECRET=dev-secret-change-in-production-must-be-at-least-32-bytes-long

# ---------------------------------------------------------------------------
# Supabase mode (IRIS_DB_BACKEND=supabase)
# ---------------------------------------------------------------------------
# All five SUPABASE_* variables are required when using Supabase mode.

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings → API → Project API keys → anon)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service_role key (Settings → API → Project API keys → service_role)
# Keep this secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL connection string — use Transaction Pooler for serverless (port 6543)
# Settings → Database → Connection string → Transaction pooler
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# JWT signing secret (Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variables, embedded in the bundle)
# ---------------------------------------------------------------------------
# These must also be set in Render's environment variables for production builds.

# Set to "supabase" when building for Render + Supabase deployment.
VITE_DB_BACKEND=sqlite

# Base URL for backend API calls — set to your Render Web Service URL for cloud
# deployment (e.g. https://iris-api.onrender.com). Leave empty for self-hosted.
VITE_API_BASE_URL=

# Only required when VITE_DB_BACKEND=supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Optional backend tuning
# ---------------------------------------------------------------------------
IRIS_DEBUG=false
IRIS_CORS_ORIGINS=http://localhost:5173
IRIS_RATE_LIMIT_LOGIN=10
IRIS_RATE_LIMIT_REFRESH=30
IRIS_RATE_LIMIT_GENERAL=1000
IRIS_AI_MAX_CONTEXT_TOKENS=8000
IRIS_AI_TIMEOUT_MS=30000
